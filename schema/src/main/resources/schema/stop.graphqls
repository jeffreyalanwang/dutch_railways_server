extend type Query {
    stopOfPassServiceAtStation(passService: ID!, station: ID!): Stop
}

extend type PassService {
    stops(after: DateTime!, maxCount: Int!): [Stop]
}

extend type Station {
    stops(after: DateTime!, maxCount: Int!): [Stop]
}

type Stop {
    passService: PassService
    station: Station
    arriveTime: DateTime
    departTime: DateTime
}

extend input MutationPassService {
    stops: [MutationStop!]!
}

input MutationStop {
    station: ID!
    arriveTime: DateTime = null
    departTime: DateTime = null
}